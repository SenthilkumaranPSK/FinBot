# ==========================================
# Place Gaurd AI — Environment Configuration
# ==========================================

# Backend Server Port
PORT=5000

# MongoDB Database URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/placeguard

# JWT Secret for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini API Key (Optional: for AI Placement Mentor cloud inference)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client API Base URL
VITE_API_URL=http://localhost:5000/api
